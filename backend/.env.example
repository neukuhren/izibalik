# --- HTTP ---
PORT=8080
HOST=0.0.0.0
# Раздавать собранный фронт из этой папки (../app/dist). Пусто = только API.
SERVE_DIST=../app/dist

# --- Telegram ---
BOT_TOKEN=000000:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# URL Mini App для кнопки /start (web_app)
MINIAPP_URL=https://example.nip.io
# Telegram ID админов через запятую (доступ к админ-API)
ADMIN_IDS=1239066805,1606026306

# --- FazerCards (поставщик UC) ---
FAZER_BASE=https://api.fzr.cards/api/v2
FAZER_API_KEY=fc_xxxxxxxxxxxxxxxxxxxxxxxx

# Курс USD->RUB по умолчанию (если /steam-topup/rates недоступен)
FALLBACK_RATE_RUB=78.07

# --- Платёжка (Platega) ---
# stub | platega
PAYMENT_PROVIDER=platega
PUBLIC_URL=https://izibalik.shop
PLATEGA_BASE=https://app.platega.io
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
PLATEGA_METHOD_SBP=2
PAY_STUB_AUTOPAY_MS=0

# --- БД ---
DB_PATH=./data/izibalik.sqlite
