{
  "name": "izibalik-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "IZIBALIK PUBG UC store backend: API, Telegram bot, FazerCards fulfillment.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "job:refresh-paid": "node dist/jobs/refresh-paid-orders.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^8.0.3",
    "fastify": "^5.2.1",
    "grammy": "^1.34.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3"
  }
}
