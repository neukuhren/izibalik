[Unit]
Description=Izibalik — сборка фронтенда при старте
Before=izibalik-web.service nginx.service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/projects/izibalik
ExecStart=/opt/projects/izibalik/deploy/bootstrap-project.sh
ExecStartPost=/bin/systemctl try-reload-or-restart nginx.service

[Install]
WantedBy=multi-user.target
