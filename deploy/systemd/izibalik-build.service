[Unit]
Description=Izibalik — сборка фронтенда при старте
Before=izibalik-web.service nginx.service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=HOME=/root
WorkingDirectory=/opt/projects/izibalik
ExecStart=/opt/projects/izibalik/deploy/bootstrap-project.sh
ExecStartPost=/usr/sbin/nginx -s reload

[Install]
WantedBy=multi-user.target
