[Unit]
Description=Izibalik — сборка фронтенда при старте
Before=izibalik-web.service nginx.service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=HOME=/root
WorkingDirectory=/opt/projects/izibalik
ExecStart=/opt/projects/izibalik/deploy/bootstrap-project.sh
# nginx может ещё не быть запущен после reboot — не валим oneshot-сборку
ExecStartPost=-/bin/systemctl try-reload-or-restart nginx

[Install]
WantedBy=multi-user.target
